# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

.DS_*

# dependencies
/node_modules
# bun is the package manager: commit bun.lock, never other lockfiles
package-lock.json
yarn.lock
pnpm-lock.yaml

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (never commit secrets; .env.example is allowed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts